# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (create a project at https://supabase.com/dashboard) ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Project Settings -> API -> service_role secret. Server-only — never expose
# this to the client or log it. Used for the public menu read path, cron
# schedule promotion, and provider-key crypto (see src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Secrets ---
# Master key used to encrypt owner-supplied AI provider API keys at rest
# (docs/05, docs/08). Generate 32+ random bytes, e.g.:
#   openssl rand -base64 32
PROVIDER_KEY_ENCRYPTION_SECRET=

# Shared secret so /api/cron/promote-schedules (scheduled publish, docs/02)
# can't be triggered by anyone else. Generate similarly to the key above.
# Set this SAME value as a Netlify site env var — the Netlify Scheduled
# Function in netlify/functions/promote-schedules.mts sends
# `Authorization: Bearer $CRON_SECRET` on every run.
CRON_SECRET=

# --- App ---
# Fallback base URL for the Netlify scheduled cron function during local
# `netlify dev` only (netlify/functions/promote-schedules.mts). Auth is email +
# password and does NOT use this. In production Netlify injects its own URL
# var, so you don't need to set this on Netlify.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which restaurant this deployment's public site serves (docs/03: the
# multi-tenant seam is a row, not a code change). Optional while there's
# only one restaurant row — src/lib/site/restaurant.ts falls back to the
# sole row — but set explicitly once a second restaurant ever exists.
SITE_RESTAURANT_SLUG=your-restaurant-slug
